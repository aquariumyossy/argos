{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Argos",
  "version": "1.3.0",
  "identifier": "com.argos.search",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Argos",
        "width": 780,
        "height": 600,
        "visible": false,
        "resizable": true
      },
      {
        "label": "popup",
        "title": "Argos",
        "width": 640,
        "height": 520,
        "minWidth": 320,
        "minHeight": 280,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": true,
        "center": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "繝ｭ繝ｼ繧ｫ繝ｫ遏･隴倥・繝ｼ繧ｹ繧剃ｸ迸ｬ縺ｧ讀懃ｴ｢縺吶ｋ繝・せ繧ｯ繝医ャ繝励い繝励Μ",
    "longDescription": "繝峨Λ繝・げ縺励◆譁・ｭ怜・繧偵Ο繝ｼ繧ｫ繝ｫ遏･隴倥・繝ｼ繧ｹ縺九ｉ迸ｬ譎ゅ↓讀懃ｴ｢縺吶ｋ Windows 繝・せ繧ｯ繝医ャ繝励い繝励Μ縲ゅヵ繧｡繧､繝ｫ逶｣隕悶・蜈ｨ譁・､懃ｴ｢繝ｻLAN 繝ｪ繝｢繝ｼ繝域､懃ｴ｢縺ｫ蟇ｾ蠢懊・,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Argos"
      }
    }
  }
}
